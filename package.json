{
  "name": "@Hyperlink-London/software-dashboard-electron",
  "version": "0.0.1",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run react\" \"npm run electron\"",
    "electron": "electron .",
    "react": "cd frontend && npm run dev",
    "prebuild": "node -e \"const { execSync } = require('child_process'); if (process.platform === 'win32') { execSync('rd /s /q dist && rd /s /q frontend\\dist', { stdio: 'inherit' }); } else { execSync('rm -rf dist frontend/dist', { stdio: 'inherit' }); }\" && cd frontend && npm ci && npm run build",
    "build": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperlink-London/software-dashboard-electron.git"
  },
  "keywords": [],
  "author": "Hyperlink London",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "build": {
    "appId": "com.hyperlinklondon.dashboard",
    "productName": "Hyperlink Dashboard",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "electron/main.js",
      "frontend/dist/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hyperlink-London",
        "repo": "software-dashboard-electron"
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  }
}
